{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "declaration": true,
        "declarationMap": true,
        "erasableSyntaxOnly": true,
        "module": "nodenext",
        "noEmit": true,
        "rewriteRelativeImportExtensions": true,
        "rootDir": ".",
        "strict": true,
        "paths": {
        },
        "target": "esnext",
        "typeRoots": [
            "../node_modules/@types"
        ],
        "types": [ "node" ],
        "useDefineForClassFields": true,
        "verbatimModuleSyntax": true
    },
    "exclude": [
    ]
}